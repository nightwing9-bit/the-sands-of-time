  "components": {
    "schemas": {
      "ActorResponse": {
        "required": [
          "subject",
          "kind",
          "roles",
          "claims"
        ],
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ApiProblem": {
        "required": [
          "code",
          "status"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "traceId": {
            "type": [
              "null",
              "string"
            ]
          },
          "timelineError": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/TimelineErrorCode"
              }
            ]
          }
        }
      },
      "ContractVersions": {
        "required": [
          "apiContract",
          "realtimeSchemaVersion",
          "timelineErrorCodes"
        ],
        "type": "object",
        "properties": {
          "apiContract": {
            "type": "string"
          },
          "realtimeSchemaVersion": {
            "type": "integer",
            "format": "int32"
          },
          "timelineErrorCodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimelineErrorCode"
            }
          }
        }
      },
      "EnrollMfaRequest": {
        "required": [
          "currentPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "GuestSessionResponse": {
        "required": [
          "subject",
          "expiresAtUtc",
          "resumed",
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "resumed": {
            "type": "boolean"
          },
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "MfaCodeRequest": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MfaEnrollment": {
        "required": [
          "sharedKey",
          "otpAuthUri"
        ],
        "type": "object",
        "properties": {
          "sharedKey": {
            "type": "string"
          },
          "otpAuthUri": {
            "type": "string"
          }
        }
      },
      "MfaVerifiedResponse": {
        "required": [
          "mfaVerifiedUntilUtc"
        ],
        "type": "object",
        "properties": {
          "mfaVerifiedUntilUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StaffLoginRequest": {
        "required": [
          "userName",
          "password",
          "totpCode"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          },
          "totpCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "StaffSessionResponse": {
        "required": [
          "accessToken",
          "tokenType",
          "accessExpiresAtUtc",
          "subject",
          "roles",
          "mfaEnrolled",
          "mfaVerifiedUntilUtc",
          "csrfToken"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
