# Copy to `.env` (gitignored) and replace every REPLACE_ME value. There are no secret defaults:
# Compose and scripts/db/migrate.sh refuse to start without them.
#   cp .env.example .env
#   for k in POSTGRES REDIS API_DB REALTIME_DB WORKER_DB; do sed -i.bak "s/=REPLACE_ME_${k}\$/=$(openssl rand -hex 24)/" .env; done
#   sed -i.bak "s/=REPLACE_ME_IDENTITY\$/=$(openssl rand -hex 32)/" .env && rm .env.bak
# Use letters/digits only for passwords (hex is fine); `;`, `,`, `=`, `$` and spaces break connection strings.

POSTGRES_DB=sands_of_time
# Superuser: used only by the one-shot migrate job (and the postgres container itself), never by a host.
POSTGRES_USER=sands
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES
# Per-host least-privilege logins sands_api, sands_realtime, sands_worker (provisioned by migrate; >= 24 letters/digits).
API_DB_PASSWORD=REPLACE_ME_API_DB
REALTIME_DB_PASSWORD=REPLACE_ME_REALTIME_DB
WORKER_DB_PASSWORD=REPLACE_ME_WORKER_DB
REDIS_PASSWORD=REPLACE_ME_REDIS
# Spec 03 identity master secret (>= 32 chars). The API refuses to start in Production with a placeholder or short value.
IDENTITY_MASTER_SECRET=REPLACE_ME_IDENTITY

# Host ports, bound to 127.0.0.1 only. Change if they clash with something already running.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
API_HOST_PORT=8081
REALTIME_HOST_PORT=8082
WORKER_HOST_PORT=8083
