    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GhostLap.Domain</AssemblyName>
    <RootNamespace>GhostLap</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only Solo/SoloOriginalStore uses the driver, for the GhostLap-owned ghostlap schema; the rule engine stays pure. -->
