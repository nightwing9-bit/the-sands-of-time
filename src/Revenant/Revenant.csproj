<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Revenant.Domain</AssemblyName>
    <RootNamespace>Revenant</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Revenant.Contracts\Revenant.Contracts.csproj" />
    <ProjectReference Include="..\Marrow.Kernel\Marrow.Kernel.csproj" />
    <ProjectReference Include="..\Marrow.Timeline\Marrow.Timeline.csproj" />
  </ItemGroup>
  <!--
    Spec 07 task 7.2: durable payment persistence and the Revenant API/LiveOps registration live in the Revenant.Payments and
    Revenant.Api namespaces. The pure finance code (Revenant.Finance, Revenant.Scenario, Revenant.Timeline) still depends on
    neither Npgsql nor ASP.NET; Revenant.Tests asserts that at the type level. The assembly never references Marrow.Infrastructure:
    the host hands it the shared outbox writer as a delegate.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <!--
    Spec 08 task 8.2: the offline risk-classifier trainer and the artifact loader (src/Revenant/Intelligence) use ML.NET core and
    FastTree only, the same pinned 5.0.1 family as the platform probe. Microsoft.ML.TimeSeries (SSA, Linux x64 only) is NOT referenced
    here. Ghost Lap and Marrow never reference ML.NET. The pure finance/scenario/timeline code does not use these namespaces.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="5.0.1" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="5.0.1" />
    <InternalsVisibleTo Include="Revenant.Tests" />
    <InternalsVisibleTo Include="Hosts.Worker" />
  </ItemGroup>
  <!-- The committed, checksummed artifact travels with the assembly so a Worker can load it from AppContext.BaseDirectory. -->
  <ItemGroup>
    <None Include="Intelligence\Artifacts\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Intelligence\Artifacts" Link="Intelligence\Artifacts\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
