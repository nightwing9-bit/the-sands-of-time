<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    Every shipped .NET module is referenced so its compiled assembly is copied next to the test
    assembly and inspected from there. A new Revenant.* / GhostLap.* domain project must be added
    here; the rules discover it by assembly-name prefix once it is in the output directory.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Marrow.Kernel\Marrow.Kernel.csproj" />
    <ProjectReference Include="..\..\src\Marrow.Timeline\Marrow.Timeline.csproj" />
    <ProjectReference Include="..\..\src\Marrow.Infrastructure\Marrow.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Revenant.Contracts\Revenant.Contracts.csproj" />
    <ProjectReference Include="..\..\src\GhostLap.Contracts\GhostLap.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Hosts.Api\Hosts.Api.csproj" />
    <ProjectReference Include="..\..\src\Hosts.Realtime\Hosts.Realtime.csproj" />
    <ProjectReference Include="..\..\src\Hosts.Worker\Hosts.Worker.csproj" />
  </ItemGroup>
</Project>
