<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <AssemblyName>Revenant.Tests</AssemblyName>
    <RootNamespace>Revenant.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FsCheck" Version="3.6.0" />
    <!--
      Spec 08 task 8.1: one pinned stable ML.NET family (core, FastTree, TimeSeries; TimeSeries brings Microsoft.ML.Mkl.Redist).
      Test-only for now: the platform probe (tests/Revenant/Platform) is the only user. The Revenant domain assembly does not
      reference ML.NET until the offline trainer (8.2) needs it; Ghost Lap and Marrow never do.
    -->
    <PackageReference Include="Microsoft.ML" Version="5.0.1" />
    <PackageReference Include="Microsoft.ML.FastTree" Version="5.0.1" />
    <PackageReference Include="Microsoft.ML.TimeSeries" Version="5.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Hosts.Worker/MlRuntimeSsa.cs" Link="Platform/MlRuntimeSsa.cs" />
    <Compile Include="../../src/Hosts.Worker/RevenantSsaInference.cs" Link="Platform/RevenantSsaInference.cs" />
    <ProjectReference Include="..\..\src\Revenant\Revenant.csproj" />
    <ProjectReference Include="..\..\src\Revenant.Contracts\Revenant.Contracts.csproj" />
    <!-- Test-only host composition of the shared Timeline over PostgreSQL; the Revenant domain itself never references Infrastructure. -->
    <ProjectReference Include="..\..\src\Marrow.Infrastructure\Marrow.Infrastructure.csproj" />
  </ItemGroup>
</Project>
